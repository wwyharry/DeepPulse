/* DeepPulse TUI 样式 - 暗色金融主题 · 三栏布局
 *
 * 色板与 deeppulse/agent/tui/palette.py 保持一致，修改时两处同步。
 * 响应式断点由 app.py 按窗口宽度切换 Screen 上的类：
 *   hide-left  (< 100 列) 隐藏左栏
 *   hide-right (< 78 列)  隐藏右栏
 */

/* ═══════════════════ 全局 ═══════════════════ */

Screen {
    background: #0c0f15;
    color: #c6ced9;
}

/* ═══════════════════ 状态栏 ═══════════════════ */

#status-bar {
    height: 1;
    dock: top;
    width: 100%;
    background: #10141c;
    color: #8791a1;
    padding: 0 1;
}

/* ═══════════════════ 主容器三栏 ═══════════════════ */

#main-container {
    width: 100%;
    height: 1fr;
}

#left-panel {
    width: 30;
    height: 1fr;
    padding: 1 0 0 1;
    overflow-y: auto;
    scrollbar-color: #1f2632;
    scrollbar-color-hover: #2c3545;
    scrollbar-color-active: #555e6e;
}

#chat-panel {
    width: 1fr;
    height: 100%;
}

#right-panel {
    width: 38;
    height: 1fr;
    padding: 1 1 0 0;
    overflow-y: auto;
    scrollbar-color: #1f2632;
    scrollbar-color-hover: #2c3545;
    scrollbar-color-active: #555e6e;
}

/* 响应式：窄窗口自动收起侧栏 */
Screen.hide-left #left-panel {
    display: none;
}

Screen.hide-right #right-panel {
    display: none;
}

/* ═══════════════════ 侧栏卡片 ═══════════════════ */

WatchlistPanel,
PortfolioPanel,
MarketPanel,
ToolPanel,
DataPanel {
    height: auto;
    background: #10141c;
    border: solid #1f2632;
    border-title-color: #5b9bd5;
    border-title-align: left;
    padding: 1 1 1 1;
    margin: 0 0 1 0;
    min-height: 5;
}

/* 工具条目：可点击展开完整结果 */
ToolEntry {
    height: auto;
    color: #c6ced9;
}

ToolEntry:hover {
    background: #151a24;
}

/* ═══════════════════ 对话区域 ═══════════════════ */

#chat-log {
    height: 1fr;
    background: #0c0f15;
    padding: 0 2 1 2;
    scrollbar-color: #1f2632;
    scrollbar-color-hover: #2c3545;
    scrollbar-color-active: #555e6e;
    scrollbar-gutter: stable;
}

#input-row {
    dock: bottom;
    height: 3;
    margin: 0 2 1 2;
}

#chat-input {
    width: 1fr;
    height: 3;
    border: solid #2c3545;
    background: #10141c;
    color: #c6ced9;
    padding: 0 1;
}

#chat-input:focus {
    border: solid #5b9bd5;
}

#chat-input .input--placeholder {
    color: #555e6e;
}

/* 停止按钮：仅分析中显示 */
#stop-btn {
    width: 9;
    height: 3;
    margin: 0 0 0 1;
    display: none;
    background: #2a1520;
    border: solid #e85a6a;
    color: #e85a6a;
}

#stop-btn.-visible {
    display: block;
}

#stop-btn:hover {
    background: #3d1f2c;
    color: #ff8a96;
}

Screen.compact #chat-log {
    padding: 0 1 1 1;
}

Screen.compact #input-row {
    margin: 0 1 1 1;
}

/* ═══════════════════ 消息 ═══════════════════ */

.msg {
    margin: 1 0 0 0;
}

/* 用户消息：亮蓝竖条 + 微凸背景 */
.msg-user {
    background: #10141c;
    border-left: thick #7db8f5;
    padding: 0 1;
    margin: 1 2 0 2;
}

/* Agent 消息：蓝色竖条 */
.msg-agent {
    border-left: thick #5b9bd5;
    padding: 0 1;
    margin: 1 2 0 2;
}

/* 系统消息：无装饰，弱化 */
.msg-system {
    margin: 1 4 0 4;
}

/* 统计摘要 */
.msg-stats {
    background: #10141c;
    border-top: solid #1f2632;
    padding: 1 1 0 1;
    margin: 1 2 0 2;
}

Screen.compact .msg-user,
Screen.compact .msg-agent,
Screen.compact .msg-stats {
    margin: 1 0 0 0;
}

/* ═══════════════════ 确认按钮 ═══════════════════ */

ConfirmationButtons {
    height: auto;
    layout: horizontal;
    align: center middle;
    padding: 1 0 0 0;
}

ConfirmationButtons Button {
    margin: 0 1;
    min-width: 14;
    height: 3;
    background: #151a24;
    border: solid #2c3545;
    color: #c6ced9;
}

ConfirmationButtons Button:hover {
    border: solid #5b9bd5;
    color: #7db8f5;
}

ConfirmationButtons Button.-primary {
    background: #1c3a2d;
    border: solid #2fb985;
    color: #2fb985;
}

ConfirmationButtons Button.-primary:hover {
    background: #24503c;
    border: solid #2fb985;
    color: #7ee2bb;
}

/* ═══════════════════ 滚动条 ═══════════════════ */

ScrollBar {
    background: #0c0f15;
}

ScrollBar:hover {
    background: #10141c;
}

/* ═══════════════════ Footer ═══════════════════ */

Footer {
    background: #10141c;
    color: #8791a1;
}

Footer > .footer--key {
    background: #151a24;
    color: #7db8f5;
}

Footer > .footer--description {
    color: #8791a1;
}
